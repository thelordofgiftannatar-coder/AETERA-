{
  "name": "brazils-cave",
  "productName": "The Brazils Cave",
  "version": "1.0.0",
  "description": "Audiobook, PDF and ambience player with a wallpaper library — Windows desktop edition.",
  "main": "main.js",
  "author": "Brazils Cave",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.brazilscave.desktop",
    "productName": "The Brazils Cave",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "app/**/*", "package.json"],
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "TheBrazilsCave-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "TheBrazilsCave-Portable-${version}.${ext}"
    }
  }
}
